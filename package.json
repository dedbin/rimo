{
  "name": "rimo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "tsx scripts/migrate.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "collaboration": "node --env-file-if-exists=.env.local --import=tsx collaboration-server/index.ts",
    "export-worker": "node --env-file-if-exists=.env.local --import=tsx export-worker/index.ts",
    "i18n:extract": "npx i18next -c i18next-parser.config.js",
    "i18n:translate": "python3 scripts/translate_i18n.py",
    "i18n": "npm run i18n:extract && npm run i18n:translate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env.local scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "verify:standalone": "node --env-file-if-exists=.env.local scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@uidotdev/usehooks": "^2.4.1",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "^8.1.0",
    "katex": "0.18.10",
    "lucide-react": "^0.509.0",
    "marked": "17.0.6",
    "motion": "^12.12.2",
    "nanoid": "^5.1.5",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "perfect-freehand": "^1.2.2",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "query-string": "^9.1.2",
    "react": "^18.3.1",
    "react-contenteditable": "^3.3.7",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.2",
    "sharp": "0.35.5",
    "sonner": "^2.0.3",
    "swr": "2.5.1",
    "tailwind-merge": "^3.2.0",
    "tsx": "4.23.15",
    "typewriter-effect": "^2.22.0",
    "usehooks-ts": "^3.1.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "yjs": "13.6.33",
    "zod": "4.6.7",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/testing-library__react": "^10.0.1",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "i18next-parser": "^9.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.8.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
